{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['host', 'seed', 'region', 'diff', 'state', 'speed'])"
        },
        "players": {
          "$pid": {
            ".validate": "$pid.matches(/^[a-z0-9]{4,12}$/) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('m').isNumber()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
